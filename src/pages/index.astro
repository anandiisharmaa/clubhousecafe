---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import About from '@/components/About.astro';
import RoyaltySection from '@/components/RoyaltySection.astro';
import Experience from '@/components/Experience.astro';
import MenuPreview from '@/components/MenuPreview.astro';
import EditorialMarquee from '@/components/EditorialMarquee.astro';
import SignatureStory from '@/components/SignatureStory.astro';
import Gallery from '@/components/Gallery.astro';
import LocationsSection from '@/components/LocationsSection.astro';
import ReservationCTA from '@/components/ReservationCTA.astro';
---

<BaseLayout>
  <!-- 1. Cinematic Hero Section -->
  <Hero />

  <!-- 2. Editorial About Section ("More Than Coffee" + Coffee / Food / Conversations) -->
  <About />

  <!-- 3. The Clubhouse Royalty Club (Privilege Teaser · Coming Soon) -->
  <RoyaltySection />

  <!-- 4. The Clubhouse Experience (Horizontal Scroll Storytelling) -->
  <Experience />

  <!-- 5. Editorial Menu Preview ("Something For Every Mood") -->
  <MenuPreview />

  <!-- Editorial Infinite Marquee Ribbon -->
  <EditorialMarquee />

  <!-- 6. Signature Cinematic Story ("Good Food / Good Coffee / Good Company / That's Clubhouse") -->
  <SignatureStory />

  <!-- 7. Editorial Asymmetric Gallery ("The Gallery of Details") -->
  <Gallery />

  <!-- 8. Locations ("Find Your Clubhouse" Jalandhar & Amritsar) -->
  <LocationsSection />

  <!-- 9. Full-Width Emotional CTA ("Save A Seat. Stay A While.") -->
  <ReservationCTA />
</BaseLayout>
