---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { businessData } from '@/data/business';

const pageTitle = `Privacy Policy | ${businessData.name}`;
const pageDescription = `Privacy Policy for Clubhouse Café in Model Town, Jalandhar and Amritsar, Punjab. Learn how we collect, protect, and respect your guest data.`;
const lastUpdated = 'September 17, 2026';
---

<BaseLayout title={pageTitle} description={pageDescription} isLegalPage={true} pageName="Privacy Policy">
  <div class="pt-32 md:pt-40 pb-20 md:pb-28 bg-ivory text-espresso min-h-screen">
    <!-- Hero Header -->
    <header class="max-w-4xl mx-auto px-6 md:px-12 mb-12 md:mb-16">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-gold-dark hover:text-espresso transition-colors mb-6 group"
      >
        <span class="transition-transform group-hover:-translate-x-1">←</span>
        <span>Back to Clubhouse</span>
      </a>

      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-[1px] bg-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.3em] font-semibold text-gold-dark">
          Guest Trust & Governance
        </span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-espresso font-bold sm:font-semibold tracking-tight leading-tight mb-4">
        Privacy <span class="italic text-gold-dark font-bold sm:font-semibold">Policy.</span>
      </h1>

      <p class="text-sm md:text-base text-espresso-muted max-w-2xl font-normal leading-relaxed">
        At Clubhouse Café, hospitality begins with trust. This document outlines how we collect, safeguard, and responsibly utilize guest information across our physical café locations in Jalandhar and Amritsar, and through our digital web experience.
      </p>

      <div class="mt-6 pt-4 border-t border-sage/20 flex items-center gap-4 text-xs text-espresso-soft">
        <span>Effective Date: {lastUpdated}</span>
        <span>·</span>
        <span>Version 2.4</span>
      </div>
    </header>

    <!-- Main Content Section -->
    <main class="max-w-4xl mx-auto px-6 md:px-12 space-y-12">
      <!-- Section 1: Overview & Philosophy -->
      <section class="rounded-3xl bg-ivory-muted/40 border border-sage/20 p-8 md:p-10">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal mb-4">
          1. Our Commitment to Your Privacy
        </h2>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal mb-4">
          Clubhouse Café ("Clubhouse", "we", "us", or "our"), operated at Ground Floor, The Elite City Center, Model Town Road, Jalandhar, Punjab, is committed to treating your personal details with the utmost discretion and care. We do not sell, rent, or trade guest data to third-party advertisers or brokers under any circumstances.
        </p>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          Whether you are reserving a corner booth for Neapolitan pizza, joining our upcoming Royalty Club, or simply browsing our seasonal coffee menu, our digital systems are designed with privacy by default.
        </p>
      </section>

      <!-- Section 2: Information We Collect -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal">
          2. Information We Collect
        </h2>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          We collect only the minimal information necessary to deliver exceptional culinary hospitality and smooth reservations:
        </p>
        <ul class="space-y-3 pt-2 text-xs sm:text-sm text-espresso-muted leading-relaxed">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark mt-2 shrink-0"></span>
            <span><strong class="text-espresso font-medium">Table Reservations & Waitlist:</strong> Full name, mobile contact number, party size, preferred seating time, location choice (Model Town Jalandhar or upcoming Amritsar), and any dietary accommodations or celebration notes.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark mt-2 shrink-0"></span>
            <span><strong class="text-espresso font-medium">Direct Inquiries & WhatsApp Concierge:</strong> Messages, feedback, or table inquiries initiated through our official WhatsApp concierge or direct phone line (+91 86997 66654).</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark mt-2 shrink-0"></span>
            <span><strong class="text-espresso font-medium">Technical & Browsing Data:</strong> Anonymized session logs, browser type, device characteristics, and performance metrics collected to ensure fast page loads and smooth navigation. We do not employ invasive cross-site tracking cookies.</span>
          </li>
        </ul>
      </section>

      <!-- Section 3: How We Use Your Information -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal">
          3. How We Use Your Information
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-6 rounded-2xl bg-ivory border border-sage/20 shadow-xs">
            <h3 class="font-serif text-lg text-espresso font-medium mb-2">Hospitality & Seating</h3>
            <p class="text-xs text-espresso-muted leading-relaxed font-normal">
              Managing table bookings, seating timelines, and accommodating guest dietary requirements or booth preferences.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-ivory border border-sage/20 shadow-xs">
            <h3 class="font-serif text-lg text-espresso font-medium mb-2">Instant Confirmations</h3>
            <p class="text-xs text-espresso-muted leading-relaxed font-normal">
              Dispatching WhatsApp or SMS booking confirmations, table readiness notifications, and directions to the café.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-ivory border border-sage/20 shadow-xs">
            <h3 class="font-serif text-lg text-espresso font-medium mb-2">Royalty Club Privileges</h3>
            <p class="text-xs text-espresso-muted leading-relaxed font-normal">
              For enrolled guests, tracking seasonal rewards, birthday surprises, and early invitations to chef's table tastings.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-ivory border border-sage/20 shadow-xs">
            <h3 class="font-serif text-lg text-espresso font-medium mb-2">Quality & Service Care</h3>
            <p class="text-xs text-espresso-muted leading-relaxed font-normal">
              Addressing guest feedback, improving café ambiance, and optimizing kitchen prep schedules based on peak hours.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 4: Data Security & Storage -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal">
          4. Security, Confidentiality & Storage
        </h2>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          All digital transmissions on clubhousecafe.in are encrypted using industry-standard Transport Layer Security (TLS/SSL). Reservation records are maintained in secure, access-controlled databases restricted solely to verified Clubhouse management and front-of-house concierge personnel.
        </p>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          We retain personal booking information only for as long as needed to honor hospitality records, provide customer support, and comply with local accounting and regulatory standards in Punjab, India.
        </p>
      </section>

      <!-- Section 5: Third-Party Integrations -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal">
          5. Third-Party Integrations & External Links
        </h2>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          Our website links to external services to enhance guest convenience, including:
        </p>
        <ul class="space-y-2.5 pt-1 text-xs sm:text-sm text-espresso-muted leading-relaxed">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark shrink-0"></span>
            <span><strong class="text-espresso font-medium">Google Maps:</strong> For interactive driving directions to our Model Town café.</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark shrink-0"></span>
            <span><strong class="text-espresso font-medium">Meta / Instagram:</strong> To view our live visual feed and community stories (@clubhousecafe.in).</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-dark shrink-0"></span>
            <span><strong class="text-espresso font-medium">WhatsApp Business:</strong> For direct two-way guest concierge communication.</span>
          </li>
        </ul>
        <p class="text-xs text-espresso-soft leading-relaxed font-normal pt-1">
          These external platforms operate under their respective independent privacy terms. We encourage guests to review their privacy policies when navigating off clubhousecafe.in.
        </p>
      </section>

      <!-- Section 6: Your Rights & Access -->
      <section class="space-y-4">
        <h2 class="font-serif text-2xl md:text-3xl text-espresso font-normal">
          6. Your Rights & Data Choices
        </h2>
        <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
          You retain full control over your personal data. At any time, you may:
        </p>
        <div class="p-6 rounded-2xl bg-sage-pale/30 border border-sage/25 space-y-2.5 text-xs sm:text-sm text-espresso-muted">
          <p>• Request a copy of the personal details stored under your contact profile.</p>
          <p>• Update or correct outdated phone numbers or dietary preferences.</p>
          <p>• Opt out of promotional WhatsApp or SMS broadcasts with a simple "STOP" reply.</p>
          <p>• Request permanent deletion of your reservation history and contact records.</p>
        </div>
      </section>

      <!-- Section 7: Contact & Inquiries -->
      <section class="pt-6 border-t border-sage/20">
        <div class="rounded-3xl bg-espresso text-ivory p-8 md:p-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-semibold block mb-1">
              Data Protection Concierge
            </span>
            <h3 class="font-serif text-2xl text-ivory font-normal mb-2">
              Have Questions Regarding Your Privacy?
            </h3>
            <p class="text-xs text-ivory/70 max-w-md font-normal leading-relaxed">
              Reach out directly to our management team. We respond to all guest privacy inquiries within 48 business hours.
            </p>
          </div>
          <div class="space-y-2 shrink-0 text-xs">
            <p class="text-ivory font-medium">Clubhouse Café Management</p>
            <p class="text-ivory/70">The Elite City Center, Model Town Rd, Jalandhar</p>
            <p class="text-gold-light">Phone: {businessData.phoneFormatted}</p>
            <p class="text-gold-light">Email: concierge@clubhousecafe.in</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
