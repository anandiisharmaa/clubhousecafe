---
import ClubhouseLogo from './ClubhouseLogo.astro';
import { businessData } from '@/data/business';
import { locationsData } from '@/data/locations';

const jalandhar = locationsData.find((l) => l.id === 'jalandhar') || locationsData[0];
---

<!-- Accessible Native HTML5 Reservation Dialog -->
<dialog
  id="reservation-dialog"
  class="fixed inset-0 z-[100] m-auto max-w-lg w-[92vw] md:w-full p-0 bg-transparent backdrop:bg-espresso/70 backdrop:backdrop-blur-sm open:animate-fade-in"
  aria-labelledby="dialog-title"
  aria-modal="true"
>
  <div class="relative bg-ivory rounded-2xl overflow-hidden shadow-2xl border border-sage/20 text-espresso p-6 sm:p-8 md:p-9 max-h-[88dvh] overflow-y-auto overscroll-contain">
    <!-- Close Button -->
    <button
      id="close-reservation-btn"
      type="button"
      class="absolute top-4 right-4 w-11 h-11 rounded-full flex items-center justify-center text-espresso/70 hover:text-espresso hover:bg-sage-pale transition-colors active:scale-95"
      aria-label="Close reservation modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Dialog Header -->
    <div class="text-center mb-6">
      <div class="flex justify-center mb-3">
        <ClubhouseLogo size="md" />
      </div>
      <p class="text-[11px] uppercase tracking-[0.25em] text-gold-dark font-semibold mb-1">
        Clubhouse Concierge
      </p>
      <h2 id="dialog-title" class="font-serif text-3xl md:text-4xl text-espresso font-bold sm:font-semibold leading-tight">
        Save a Seat
      </h2>
      <p class="text-xs md:text-sm text-espresso-muted mt-2 max-w-sm mx-auto leading-relaxed">
        Connect directly with our host team in Jalandhar for reservations, gatherings, and special seating requests.
      </p>
    </div>

    <!-- Booking Actions (Connected to verified channels) -->
    <div class="space-y-3.5 mb-7">
      <!-- WhatsApp Direct Option -->
      <a
        href={businessData.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between p-4 rounded-xl bg-sage-pale hover:bg-sage-light/60 border border-sage/25 transition-all duration-200"
      >
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-emerald-600/10 text-emerald-800 flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.072-1.84-.423-1.61-.663-2.64-2.316-2.72-2.424-.08-.108-.65-.865-.65-1.65 0-.784.41-1.17.556-1.328.146-.159.32-.198.428-.198.107 0 .215.002.308.007.098.005.23-.037.36.275.134.32.457 1.115.497 1.196.04.081.067.176.013.283-.053.107-.08.175-.16.27-.08.094-.168.21-.24.282-.08.08-.163.167-.07.327.094.16.417.688.895 1.114.614.547 1.13.717 1.29.797.16.081.253.067.347-.04.094-.108.4-.467.507-.628.107-.16.214-.134.36-.08.147.053.935.441 1.096.522.16.08.267.12.307.187.04.067.04.388-.104.793z"/>
            </svg>
          </div>
          <div>
            <span class="block font-serif text-lg text-espresso font-medium">Reserve via WhatsApp</span>
            <span class="block text-[11px] text-espresso-soft">Fastest confirmation · Instant concierge response</span>
          </div>
        </div>
        <svg class="w-4 h-4 text-espresso/40 group-hover:text-espresso group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Call Directly Option -->
      <a
        href={businessData.phoneHref}
        class="group flex items-center justify-between p-4 rounded-xl bg-ivory-muted hover:bg-cream/70 border border-sage/20 transition-all duration-200"
      >
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-lg bg-gold/15 text-gold-dark flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <span class="block font-serif text-lg text-espresso font-medium">Call Clubhouse Directly</span>
            <span class="block text-[11px] text-espresso-soft">{businessData.phoneFormatted} · 9:30 AM – 12:00 AM</span>
          </div>
        </div>
        <svg class="w-4 h-4 text-espresso/40 group-hover:text-espresso group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Verified Location Details -->
    <div class="p-4 rounded-xl bg-ivory-muted/60 border border-sage/15 text-xs text-espresso-muted space-y-1.5">
      <div class="flex items-center justify-between text-[11px] font-semibold tracking-wider uppercase text-espresso">
        <span>{jalandhar.city} Flagship</span>
        <span class="text-emerald-700 font-medium">Open Today</span>
      </div>
      <p class="leading-relaxed">{jalandhar.fullAddress}</p>
      <div class="pt-2 flex items-center justify-between border-t border-sage/15 text-[11px]">
        <span>Daily Hours: {jalandhar.hours}</span>
        <a
          href={jalandhar.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gold-dark hover:underline font-medium"
        >
          View Map →
        </a>
      </div>
    </div>
  </div>
</dialog>

<script>
  function setupReservationModal() {
    const dialog = document.getElementById('reservation-dialog') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('close-reservation-btn');
    const openBtns = document.querySelectorAll('[data-open-reservation]');

    if (!dialog) return;

    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
        document.body.classList.add('overflow-hidden');
      });
    });

    function closeModal() {
      if (!dialog) return;
      dialog.close();
      document.body.classList.remove('overflow-hidden');
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Light dismiss: Close when clicking dialog backdrop
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;

      if (!isInDialog) {
        closeModal();
      }
    });

    // Handle escape key
    dialog.addEventListener('close', () => {
      document.body.classList.remove('overflow-hidden');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupReservationModal);
  } else {
    setupReservationModal();
  }
</script>
