---
// In-House Brand Family of Clubhouse: Arth (Banquet 200+ Pax) & Koko (Bar 50 Pax) · Jalandhar
interface InhouseBrand {
  id: string;
  name: string;
  tagline: string;
  category: string;
  capacity: string;
  location: string;
  description: string;
  phone?: string;
  phoneFormatted?: string;
  phoneHref?: string;
  whatsappHref?: string;
  logoSrc: string;
  logoAlt: string;
  logoHeightClass: string;
  primaryImage: string;
  features: string[];
}

const inhouseBrands: InhouseBrand[] = [
  {
    id: 'arth-banquet',
    name: 'Arth',
    tagline: 'Banquet by Clubhouse',
    category: 'Grand Celebrations & Events',
    capacity: '200+ Pax',
    location: 'Model Town, Jalandhar',
    description:
      'A luxury banquet hall designed for your special occasions. Whether you are hosting a wedding function, birthday, anniversary, or corporate event, Arth offers comfortable seating for 200+ guests, beautiful decor, and delicious food.',
    logoSrc: '/images/inhouse/logo-arth-clean.webp',
    logoAlt: 'Arth - Banquet by Clubhouse Logo',
    logoHeightClass: 'h-16 sm:h-20 md:h-24',
    primaryImage: '/images/inhouse/arth-banquet-hall.webp',
    features: [
      'Fits 200+ Guests Comfortably',
      'Warm Ambience & Modern Decor',
      'Fresh Multi-Cuisine Food Menus',
      'Dedicated Event & Service Staff',
    ],
  },
  {
    id: 'koko-bar',
    name: 'Koko',
    tagline: 'Bar by Clubhouse',
    category: 'Private Cocktail Bar & Lounge',
    capacity: '50 Pax',
    location: 'Model Town, Jalandhar',
    description:
      'An intimate private bar and lounge for your parties and evening gatherings. Host up to 50 guests with handcrafted cocktails, great music, tasty bar snacks, and a cozy private party vibe.',
    phone: '08699766654',
    phoneFormatted: '+91 86997 66654',
    phoneHref: 'tel:08699766654',
    whatsappHref:
      'https://wa.me/918699766654?text=Hello%20Koko%20by%20Clubhouse%2C%20I%20would%20like%20to%20book%20the%20bar%20for%20a%20private%20event.',
    logoSrc: '/images/inhouse/logo-koko-clean.webp',
    logoAlt: 'Koko - Bar by Clubhouse Logo',
    logoHeightClass: 'h-20 sm:h-24 md:h-28',
    primaryImage: '/images/inhouse/koko-bar-hero.webp',
    features: [
      'Private Space for 50 Guests',
      'Handcrafted Cocktails & Drinks',
      'Great Sound System & Music',
      'Delicious Finger Food & Snacks',
    ],
  },
];
---

<section
  id="signature-story"
  class="relative py-20 md:py-28 px-6 md:px-12 lg:px-16 bg-espresso text-ivory overflow-hidden content-auto"
  aria-label="In-House Brands of Clubhouse"
>
  <!-- Ambient Warmth Orbs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden z-0" aria-hidden="true">
    <div class="absolute -top-32 right-10 w-[500px] h-[500px] rounded-full bg-gold/10 blur-[130px]"></div>
    <div class="absolute -bottom-32 left-10 w-[500px] h-[500px] rounded-full bg-gold/10 blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24">
      <div class="inline-flex items-center gap-3 mb-3">
        <span class="w-8 h-[1px] bg-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.3em] font-semibold text-gold-light">
          In-House Brands · Jalandhar
        </span>
        <span class="w-8 h-[1px] bg-gold"></span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-ivory font-bold sm:font-semibold leading-tight">
        The Clubhouse <br class="hidden sm:inline" />
        <span class="italic text-gold font-normal">Hospitality Family.</span>
      </h2>
      <p class="font-sans text-sm sm:text-base text-ivory/70 mt-4 max-w-xl mx-auto leading-relaxed">
        Looking to host an event? From grand family celebrations to private parties and drinks, we have the perfect place for you.
      </p>
    </div>

    <!-- 2 Master Showcase Panels (Arth & Koko) -->
    <div class="space-y-20 md:space-y-32">
      {inhouseBrands.map((brand, idx) => (
        <article
          class={`story-panel grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center ${
            idx % 2 === 1 ? 'lg:flex-row-reverse' : ''
          }`}
        >
          <!-- Content Column -->
          <div class={`lg:col-span-6 ${idx % 2 === 1 ? 'lg:order-2 lg:pl-4' : 'lg:pr-4'}`}>
            <!-- Brand Logo as Primary Name (Prominent & Clean) -->
            <div class="mb-6 flex items-center">
              <h3 class="sr-only">{brand.name} - {brand.tagline}</h3>
              <img
                src={brand.logoSrc}
                alt={brand.logoAlt}
                class={`story-panel-title ${brand.logoHeightClass} w-auto object-contain drop-shadow-xl`}
                loading="lazy"
              />
            </div>

            <p class="font-sans text-sm sm:text-base text-ivory/80 leading-relaxed max-w-xl mb-6 font-normal">
              {brand.description}
            </p>

            <!-- Specs Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-2">
              {brand.features.map((feature) => (
                <div class="flex items-center gap-2.5 text-xs sm:text-sm text-ivory/85">
                  <span class="text-gold text-xs">✦</span>
                  <span>{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Imagery Column with Ambient Shadow Glow Effect -->
          <div class={`lg:col-span-6 ${idx % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div class="relative group">
              <!-- Golden Ambient Glow Aura behind image -->
              <div
                class="absolute -inset-3 sm:-inset-5 rounded-[36px] bg-gradient-to-tr from-gold/35 via-gold-dark/25 to-gold-light/25 blur-2xl sm:blur-3xl opacity-65 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700 pointer-events-none -z-10"
                aria-hidden="true"
              ></div>

              <!-- Deep Cast Shadow behind image -->
              <div
                class="absolute inset-2 sm:inset-4 translate-y-6 sm:translate-y-8 rounded-3xl bg-black/85 blur-2xl -z-10 pointer-events-none"
                aria-hidden="true"
              ></div>

              <!-- Image Tile Container -->
              <div class="relative rounded-3xl overflow-hidden aspect-[4/3] bg-espresso-light border border-gold/30 group-hover:border-gold/55 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_30px_rgba(200,168,118,0.2)] transition-all duration-500 group-hover:-translate-y-1">
                <img
                  src={brand.primaryImage}
                  alt={`${brand.name} ${brand.tagline} interior in Jalandhar`}
                  class="story-panel-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-espresso/80 via-transparent to-transparent pointer-events-none"></div>

                <!-- Overlaid badge bottom -->
                <div class="absolute bottom-5 left-6 right-6 flex items-center justify-between text-xs text-ivory/90">
                  <span class="font-serif italic text-gold-light text-sm sm:text-base font-medium drop-shadow-md">
                    {brand.name} · {brand.capacity}
                  </span>
                  <span class="text-[11px] uppercase tracking-widest text-ivory/80 font-sans font-medium drop-shadow-md">
                    {brand.location}
                  </span>
                </div>
              </div>
            </div>

            <!-- CTAs: Call & WhatsApp (Positioned Below Image) -->
            {brand.phoneHref && (
              <div class="flex flex-wrap items-center gap-3.5 sm:gap-4 pt-6 sm:pt-7 justify-start">
                <a
                  href={brand.phoneHref}
                  class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-gold text-espresso font-semibold text-xs tracking-wider uppercase hover:bg-gold-light transition-all duration-200 shadow-md hover:shadow-lg hover:-translate-y-0.5"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call {brand.phoneFormatted}</span>
                </a>

                {brand.whatsappHref && (
                  <a
                    href={brand.whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-3 rounded-full border border-white/20 text-ivory text-xs tracking-wider uppercase font-medium hover:bg-white/10 hover:border-white/40 transition-all duration-200"
                  >
                    <span>Inquire on WhatsApp →</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
