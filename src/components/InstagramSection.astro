---
import OptimizedImage from './OptimizedImage.astro';
import { businessData } from '@/data/business';

const instaMoments = [
  { id: 'strawberry-matcha-latte', label: 'Matcha Rituals' },
  { id: 'teddy-mousse', label: 'Iconic Teddy Mousse' },
  { id: 'buratta-neapolitan-pizza', label: 'Wood-Fired Burrata' },
  { id: 'belgian-croissant', label: 'Morning Viennoiserie' },
  { id: 'avocado-toast', label: 'Sourdough Tartines' },
  { id: 'tres-leches', label: 'Saffron Milk Cake' },
];
---

<section
  class="relative py-16 md:py-20 px-6 md:px-12 lg:px-16 bg-ivory border-t border-espresso/8 overflow-hidden content-auto"
  aria-label="Instagram Community Showcase"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 md:mb-16">
      <div>
        <span class="text-[11px] uppercase tracking-[0.3em] font-semibold text-gold-dark block mb-2">
          From The Clubhouse
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-espresso font-bold sm:font-semibold">
          Moments Worth Coming Back For.
        </h2>
      </div>

      <div>
        <a
          href={businessData.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-ivory hover:bg-espresso text-espresso hover:text-ivory border border-sage/30 text-xs uppercase tracking-[0.18em] font-medium transition-all duration-300 shadow-xs hover:shadow-md"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>Follow {businessData.instagramHandle}</span>
        </a>
      </div>
    </div>

    <!-- 6-Image Seamless Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {instaMoments.map((item) => (
        <a
          href={businessData.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative aspect-square rounded-xl overflow-hidden bg-ivory-muted block"
          aria-label={`View ${item.label} on Instagram`}
        >
          <OptimizedImage
            id={item.id}
            imgClass="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500 ease-out"
            sizes="(max-width: 768px) 50vw, 16vw"
            dataCursor="open"
          />
          <!-- Hover Overlay -->
          <div class="absolute inset-0 bg-espresso/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-3 text-center text-ivory">
            <svg class="w-6 h-6 text-gold-light mb-1.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162z"/>
            </svg>
            <span class="text-[10px] tracking-wider uppercase font-medium">{item.label}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
