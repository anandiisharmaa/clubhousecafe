---
import OptimizedImage from './OptimizedImage.astro';
import { businessData } from '@/data/business';
---

<section
  id="hero"
  class="relative w-full h-[100svh] min-h-[620px] grid grid-rows-[1fr_auto] overflow-hidden bg-espresso scroll-mt-24 select-none"
  aria-label="Clubhouse Café Welcome"
>
  <!-- Full-Bleed Architectural Visual Canvas with Ken-Burns Ambient Motion -->
  <div class="hero-media-wrapper absolute inset-0 z-0">
    <picture class="block overflow-hidden w-full h-full">
      <!-- Mobile Art-Directed Hero: hedge sign & building board 100% visible with safe margins, seamless sky & floor transitions -->
      <source
        media="(max-width: 640px)"
        type="image/avif"
        srcset="/images/optimized/ambience-hero-mobile-480w.avif 480w, /images/optimized/ambience-hero-mobile-768w.avif 768w, /images/optimized/ambience-hero-mobile-1000w.avif 1000w"
        sizes="100vw"
      />
      <source
        media="(max-width: 640px)"
        type="image/webp"
        srcset="/images/optimized/ambience-hero-mobile-480w.webp 480w, /images/optimized/ambience-hero-mobile-768w.webp 768w, /images/optimized/ambience-hero-mobile-1000w.webp 1000w"
        sizes="100vw"
      />
      <!-- Desktop & Tablet Hero: Widescreen high-resolution exterior view -->
      <source
        type="image/avif"
        srcset="/images/optimized/ambience-dining-hall-768w.avif 768w, /images/optimized/ambience-dining-hall-1080w.avif 1080w"
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset="/images/optimized/ambience-dining-hall-768w.webp 768w, /images/optimized/ambience-dining-hall-1080w.webp 1080w"
        sizes="100vw"
      />
      <img
        src="/images/optimized/ambience-dining-hall-1080w.webp"
        alt="Clubhouse Café stunning night exterior: glowing golden CLUBHOUSE hedge sign, lit facade with CLUBHOUSE CAFE signage, Clubhouse branded flower bucket, velvet rope entrance, and elegant checkered marble courtyard."
        width="939"
        height="1379"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        class="w-full h-full object-cover object-top sm:object-[center_12%] scale-100 will-change-transform motion-safe:animate-hero-kenburns"
      />
    </picture>
    <!-- Haute-Couture Lighting, Warm Ambient Spotlight & Depth Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#120E0C]/95 via-[#120E0C]/35 to-[#120E0C]/25 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#120E0C]/85 via-[#120E0C]/35 to-transparent pointer-events-none"></div>
    <!-- Warm Golden Radial Spotlight Aura -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_55%_at_50%_38%,rgba(200,168,118,0.2),transparent_72%)] pointer-events-none"></div>
    <!-- Stronger bottom gradient to anchor the bottom strip -->
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[#120E0C] to-transparent pointer-events-none"></div>
  </div>

  <!-- Main Content Row (1fr): fills available height, content justified to bottom -->
  <div class="relative z-10 flex flex-col justify-end w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 pb-5 sm:pb-8 min-h-0"
    style="padding-top: max(5rem, calc(env(safe-area-inset-top) + 4rem))">

    <!-- Google My Business Verified Rating -->
    <div class="hero-eyebrow flex flex-wrap items-center gap-3 sm:gap-4 mb-5 sm:mb-7">
      <a
        href={businessData.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/35 hover:bg-black/55 backdrop-blur-md border border-white/20 hover:border-gold/50 text-ivory text-[11px] sm:text-xs transition-all duration-300 shadow-xs group cursor-pointer"
        aria-label="View Clubhouse Café 4.3 rating on Google Maps"
      >
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.3 9 5 12 5z" />
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z" />
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9c0-.2 0-.3 0-.5z" />
          <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.3-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z" />
        </svg>
        <div class="flex items-center text-gold text-xs leading-none">
          <span>★</span><span>★</span><span>★</span><span>★</span><span class="text-gold/60">★</span>
        </div>
        <span class="font-semibold text-white tracking-wide">{businessData.rating}</span>
        <span class="text-white/65 text-[10px] hidden sm:inline tracking-wider font-normal">({businessData.ratingCount} Google Reviews)</span>
        <span class="text-gold-light text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>
    </div>

    <!-- Brand Eyebrow Tag -->
    <div class="hero-tag flex items-center gap-2.5 mb-3 sm:mb-4">
      <span class="text-gold text-[11px]">✦</span>
      <span class="text-[10px] sm:text-xs font-sans tracking-[0.28em] uppercase text-gold-light/90 font-medium">
        Artisanal Café & Pâtisserie
      </span>
      <span class="w-6 h-[1px] bg-gold/40"></span>
    </div>

    <!-- Display Headline with Metallic Gold Gradient -->
    <h1 class="hero-title font-serif text-[3.2rem] xs:text-5xl sm:text-7xl md:text-8xl lg:text-9xl text-ivory tracking-tight leading-[0.95] mb-4 sm:mb-6 font-normal">
      A Place To <br />
      <span class="hero-title-italic italic font-serif bg-gradient-to-r from-[#FFF4DB] via-[#E4D3B0] to-[#C8A876] bg-clip-text text-transparent drop-shadow-sm font-normal">
        Slow Down.
      </span>
    </h1>

    <!-- Subtext -->
    <div class="flex items-center gap-3 sm:gap-4 mb-7 sm:mb-8 max-w-xl">
      <span class="hidden sm:block w-8 h-[1px] bg-gold/60 shrink-0"></span>
      <p class="hero-subtext font-sans text-sm sm:text-base md:text-lg text-ivory/85 leading-relaxed font-light">
        {businessData.heroSubtext}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="hero-actions flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 w-full sm:w-auto">
      <a
        href="#menu"
        class="relative group/shimmer inline-flex items-center justify-center min-h-[50px] sm:min-h-[52px] px-8 py-3.5 rounded-full bg-gradient-to-r from-[#D8B467] via-[#E2C785] to-[#C99E4A] hover:brightness-105 text-espresso text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-[1.02] active:scale-[0.97] text-center gap-2 overflow-hidden"
      >
        <span class="absolute inset-0 -translate-x-full animate-shimmer-sweep bg-gradient-to-r from-transparent via-white/40 to-transparent pointer-events-none will-change-transform"></span>
        <span class="relative z-10 font-bold">Explore The Menu</span>
        <span class="relative z-10 text-sm font-bold group-hover/shimmer:translate-x-1 transition-transform">→</span>
      </a>

      <button
        type="button"
        data-open-reservation
        class="inline-flex items-center justify-center min-h-[50px] sm:min-h-[52px] px-8 py-3.5 rounded-full bg-white/10 hover:bg-white/20 active:bg-white/25 backdrop-blur-md border border-white/25 text-ivory text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-300 hover:scale-[1.02] active:scale-[0.97] text-center gap-2 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-gold-light shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Reserve a Table</span>
      </button>
    </div>

  </div>

  <!-- Bottom Atmosphere Strip: Fills dead bottom space with rich info on mobile -->
  <div class="relative z-10 w-full px-6 md:px-12 lg:px-16 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">

      <!-- Left: Location & Hours -->
      <div class="flex flex-col gap-0.5">
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span data-live-status-dot class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
          </span>
          <span data-live-status-text class="text-[10px] sm:text-xs text-ivory/70 font-medium tracking-wide">Open Today until 12 AM</span>
        </div>
        <span class="text-[10px] sm:text-xs text-ivory/45 tracking-[0.18em] uppercase font-light">
          Jalandhar · Amritsar
        </span>
      </div>


      <!-- Right: Instagram handle -->
      <a
        href={businessData.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-end gap-0.5 group cursor-pointer"
        aria-label="Follow Clubhouse on Instagram"
      >
        <span class="text-[10px] sm:text-xs text-ivory/45 tracking-[0.18em] uppercase font-light group-hover:text-gold-light transition-colors">Instagram</span>
        <span class="text-[10px] sm:text-xs text-ivory/70 font-medium tracking-wide group-hover:text-gold-light transition-colors">{businessData.instagramHandle}</span>
      </a>

    </div>
  </div>

</section>

<style>
  /* 21st.dev Ambient Ken-Burns Breathing Zoom for Hero Visual */
  @keyframes hero-kenburns {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
    100% {
      transform: scale(1);
    }
  }

  .animate-hero-kenburns {
    animation: hero-kenburns 22s ease-in-out infinite alternate;
  }

  /* Shimmer Light Reflection Sweep for Primary CTA Button */
  @keyframes shimmer-sweep {
    0% {
      transform: translateX(-100%);
    }
    40%, 100% {
      transform: translateX(200%);
    }
  }

  .animate-shimmer-sweep {
    animation: shimmer-sweep 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }


  /* Mobile-first entrance stagger (100% GPU accelerated, 0 lag before JS load) */
  @media (max-width: 1023px) {
    .hero-eyebrow {
      animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
    }
    .hero-tag {
      animation: hero-fade-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
    }
    .hero-title {
      animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
    }
    .hero-subtext {
      animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
    }
    .hero-actions {
      animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
