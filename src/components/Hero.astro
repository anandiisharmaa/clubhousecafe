---
import OptimizedImage from './OptimizedImage.astro';
import { businessData } from '@/data/business';
---

<section
  id="hero"
  class="relative w-full h-[100svh] min-h-[520px] sm:min-h-[600px] md:min-h-[660px] flex flex-col justify-between overflow-hidden bg-espresso scroll-mt-24 select-none"
  aria-label="Clubhouse Café Welcome"
>
  <!-- Full-Bleed Architectural Visual Canvas -->
  <div class="hero-media-wrapper absolute inset-0 z-0">
    <OptimizedImage
      id="ambience-dining-hall"
      priority={true}
      class="w-full h-full"
      imgClass="w-full h-full object-cover scale-100 will-change-transform"
      sizes="100vw"
    />
    <!-- Haute-Couture Lighting & Depth Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#120E0C] via-[#120E0C]/45 to-[#120E0C]/55 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#120E0C]/85 via-[#120E0C]/40 to-transparent pointer-events-none"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,transparent_20%,rgba(18,14,12,0.65)_100%)] pointer-events-none"></div>
  </div>

  <!-- Center Editorial Stage -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 pt-24 sm:pt-32 pb-4 sm:pb-12 my-auto">
    <!-- Google My Business Verified Rating -->
    <div class="hero-eyebrow flex flex-wrap items-center gap-3 sm:gap-4 mb-6 sm:mb-8">
      <!-- Google My Business Rating Badge (Interactive link to Google Maps) -->
      <a
        href={businessData.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/35 hover:bg-black/55 backdrop-blur-md border border-white/20 hover:border-gold/50 text-ivory text-[11px] sm:text-xs transition-all duration-300 shadow-xs group cursor-pointer"
        aria-label="View Clubhouse Café 4.3 rating on Google Maps"
      >
        <!-- Google G Icon -->
        <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.7l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.3 9 5 12 5z" />
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z" />
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2s.7 5.5 1.9 7.9l3.7-2.9c0-.2 0-.3 0-.5z" />
          <path fill="#34A853" d="M12 23.5c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.3-6.4-5.2L1.9 16.5C3.7 20.2 7.5 23.5 12 23.5z" />
        </svg>

        <!-- Star Cluster -->
        <div class="flex items-center text-gold text-xs leading-none">
          <span>★</span><span>★</span><span>★</span><span>★</span><span class="text-gold/60">★</span>
        </div>

        <span class="font-semibold text-white tracking-wide">{businessData.rating}</span>
        <span class="text-white/65 text-[10px] hidden sm:inline tracking-wider font-normal">({businessData.ratingCount} Google Reviews)</span>
        <span class="text-gold-light text-xs group-hover:translate-x-0.5 transition-transform">↗</span>
      </a>
    </div>

    <!-- The Majestic Display Headline -->
    <h1 class="hero-title font-serif text-5xl sm:text-7xl md:text-8xl lg:text-9xl text-ivory tracking-tight leading-[0.96] mb-5 sm:mb-7 font-normal">
      A Place To <br />
      <span class="hero-title-italic italic font-serif text-gold-light font-normal drop-shadow-sm">
        Slow Down.
      </span>
    </h1>

    <!-- Poetic Narrative with Hairline Rule -->
    <div class="flex items-center gap-4 mb-8 sm:mb-10 max-w-xl">
      <span class="hidden sm:block w-8 h-[1px] bg-gold/60 shrink-0"></span>
      <p class="hero-subtext font-sans text-sm sm:text-base md:text-lg text-ivory/85 leading-relaxed font-light drop-shadow-xs">
        {businessData.heroSubtext}
      </p>
    </div>

    <!-- Luxury Action Buttons -->
    <div class="hero-actions flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 sm:gap-5 w-full sm:w-auto">
      <a
        href="#menu"
        class="inline-flex items-center justify-center min-h-[50px] px-9 py-4 rounded-full bg-gradient-to-r from-[#D8B467] via-[#E2C785] to-[#C99E4A] hover:brightness-110 text-espresso text-xs uppercase tracking-[0.22em] font-semibold transition-all duration-300 shadow-xl hover:shadow-2xl hover:scale-[1.02] active:scale-[0.98] text-center gap-2"
      >
        <span>Explore The Menu</span>
        <span class="text-sm">→</span>
      </a>
      <button
        type="button"
        data-open-reservation
        class="inline-flex items-center justify-center min-h-[50px] px-9 py-4 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/25 text-ivory text-xs uppercase tracking-[0.22em] font-semibold transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] text-center"
      >
        Reserve a Table
      </button>
    </div>
  </div>

  <!-- Center Animated Scroll Affordance -->
  <div class="relative z-10 w-full px-6 md:px-12 lg:px-16 py-2.5 sm:py-6 pb-3 sm:pb-6 flex justify-center">
    <a
      href="#about"
      class="flex items-center gap-2 text-gold-light/80 hover:text-gold-light transition-colors group"
      aria-label="Scroll to discover story"
    >
      <span class="text-[10px] uppercase tracking-[0.28em] font-medium hidden md:inline">Scroll To Discover</span>
      <svg class="w-4 h-4 animate-bounce text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
