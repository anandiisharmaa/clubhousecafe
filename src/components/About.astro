---
import OptimizedImage from './OptimizedImage.astro';
import { businessData } from '@/data/business';
---

<section
  id="about"
  class="relative pt-8 pb-16 sm:pt-14 sm:pb-20 md:py-28 px-6 md:px-12 lg:px-16 bg-ivory overflow-hidden"
  aria-label="About Clubhouse Café"
>
  <div class="max-w-7xl mx-auto">
    <!-- Top Eyebrow -->
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-[1px] bg-gold"></span>
      <span class="text-[11px] uppercase tracking-[0.3em] font-semibold text-gold-dark">
        The Clubhouse Ethos
      </span>
    </div>

    <!-- Editorial 2-Column Magazine Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start mb-20">
      <!-- Left Column: Story & Visual Collage -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <h2 class="font-serif text-4xl sm:text-5xl md:text-6xl text-espresso tracking-tight leading-[1.05] font-bold sm:font-semibold mb-6">
            More Than <br />
            <span class="font-serif italic text-gold-dark font-bold sm:font-semibold">Coffee.</span>
          </h2>
          <p class="font-sans text-base sm:text-lg text-espresso-muted leading-relaxed font-normal">
            {businessData.description}
          </p>
        </div>

        <!-- 2 Side-by-Side Curated Dish Previews — clean, no label boxes -->
        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="group rounded-xl overflow-hidden bg-ivory-muted">
            <div class="aspect-[4/3] overflow-hidden">
              <OptimizedImage
                id="turkish-eggs"
                class="w-full h-full"
                imgClass="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                sizes="300px"
              />
            </div>
          </div>

          <div class="group rounded-xl overflow-hidden bg-ivory-muted">
            <div class="aspect-[4/3] overflow-hidden">
              <OptimizedImage
                id="tres-leches"
                class="w-full h-full"
                imgClass="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                sizes="300px"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: The Three Elements — editorial left-border style -->
      <div class="lg:col-span-6 flex flex-col gap-0 pt-2 divide-y divide-sage/20">
        <!-- 01: COFFEE -->
        <div class="group py-7 pl-6 border-l-2 border-l-gold/60 hover:border-l-gold transition-colors duration-300">
          <div class="flex items-baseline justify-between mb-2">
            <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-semibold">01 / The Coffee Bar</span>
            <span class="font-serif text-sm italic text-espresso-soft">Uji & Single-Origin</span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl text-espresso font-bold sm:font-semibold mb-2 group-hover:text-gold-dark transition-colors">
            Coffee.
          </h3>
          <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
            Precision extractions, velvety milk micro-foam, single-origin roasts, and layered ceremonial matcha crafted for mindful mornings and late afternoon pick-me-ups.
          </p>
        </div>

        <!-- 02: FOOD -->
        <div class="group py-7 pl-6 border-l-2 border-l-sage/40 hover:border-l-gold transition-colors duration-300">
          <div class="flex items-baseline justify-between mb-2">
            <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-semibold">02 / The Artisan Kitchen</span>
            <span class="font-serif text-sm italic text-espresso-soft">Wood-Fired & Fresh</span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl text-espresso font-bold sm:font-semibold mb-2 group-hover:text-gold-dark transition-colors">
            Food.
          </h3>
          <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
            Leopard-crusted Neapolitan burrata pizzas, smashed sourdough avocado tartines, Turkish poached eggs, and savory small plates made from scratch with genuine love.
          </p>
        </div>

        <!-- 03: CONVERSATIONS -->
        <div class="group py-7 pl-6 border-l-2 border-l-sage/40 hover:border-l-gold transition-colors duration-300">
          <div class="flex items-baseline justify-between mb-2">
            <span class="text-[10px] uppercase tracking-[0.25em] text-gold font-semibold">03 / The Living Space</span>
            <span class="font-serif text-sm italic text-espresso-soft">Model Town Sanctuary</span>
          </div>
          <h3 class="font-serif text-3xl sm:text-4xl text-espresso font-bold sm:font-semibold mb-2 group-hover:text-gold-dark transition-colors">
            Conversations.
          </h3>
          <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed font-normal">
            A sanctuary crafted for unhurried living. Fluted sage velvet seating, sunlit Carrara marble, and hours that effortlessly melt away in good company.
          </p>
        </div>
      </div>
    </div>

    <!-- Editorial Accent Quote — clean typographic treatment, no box -->
    <div class="border-t border-sage/20 pt-12 max-w-3xl mx-auto text-center">
      <p class="font-serif italic text-xl sm:text-2xl md:text-3xl text-gold-dark leading-snug">
        "The ideal destination for coffee enthusiasts, food lovers and anyone looking for a cozy spot to socialise, read, or simply savour a delightful cup."
      </p>
      <div class="mt-6 flex items-center justify-center gap-3 text-[10px] uppercase tracking-[0.3em] font-semibold text-gold-dark/80">
        <span class="w-6 h-[1px] bg-gold/50"></span>
        <span>Clubhouse</span>
        <span class="w-6 h-[1px] bg-gold/50"></span>
      </div>
    </div>
  </div>
</section>
