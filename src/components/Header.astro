---
import ClubhouseLogo from './ClubhouseLogo.astro';
import { businessData } from '@/data/business';

interface Props {
  class?: string;
}

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

const navLinks = [
  { label: 'About', href: '/#about' },
  { label: 'Loyalty', href: '/#loyalty' },
  { label: 'Menu', href: '/#menu' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Gallery', href: '/#gallery' },
  { label: 'Locations', href: '/#locations' },
];
---

<header
  id="main-navbar"
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-out pt-[max(1rem,env(safe-area-inset-top))] pb-4 md:py-6 px-6 md:px-12 lg:px-16 ${
    !isHome ? 'scrolled' : ''
  }`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo: Dual Adaptive with smooth cross-fade -->
    <div class="relative flex items-center">
      <div class="nav-logo-white transition-opacity duration-300">
        <ClubhouseLogo variant="white" size="sm" />
      </div>
      <div class="nav-logo-dark absolute inset-0 opacity-0 transition-opacity duration-300 pointer-events-none">
        <ClubhouseLogo variant="dark" size="sm" />
      </div>
    </div>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 xl:gap-11" aria-label="Main Navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="nav-link relative font-sans text-xs uppercase tracking-[0.2em] font-medium transition-colors duration-200 py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-gold after:transition-all after:duration-300 hover:after:w-full"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <!-- Call Direct Button (Desktop subtle) -->
      <a
        href={businessData.phoneHref}
        class="nav-phone hidden xl:inline-flex items-center gap-2 text-xs tracking-wider uppercase font-medium transition-colors"
        aria-label={`Call Clubhouse at ${businessData.phoneFormatted}`}
      >
        <svg class="w-3.5 h-3.5 text-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{businessData.phoneFormatted}</span>
      </a>

      <!-- Primary CTA: Book a Table -->
      <button
        type="button"
        data-open-reservation
        class="nav-cta hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full text-xs uppercase tracking-[0.18em] font-semibold transition-all duration-300 shadow-sm hover:scale-[1.02] active:scale-[0.98]"
      >
        Book a Table
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-open-btn"
        type="button"
        class="nav-mobile-btn lg:hidden w-11 h-11 min-w-[44px] min-h-[44px] rounded-full flex flex-col items-center justify-center gap-1.5 backdrop-blur-md active:scale-95 transition-all"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="nav-bar-line w-5 h-[1.5px] transition-all duration-300"></span>
        <span class="nav-bar-line w-3.5 h-[1.5px] transition-all duration-300 self-end mr-3"></span>
      </button>
    </div>
  </div>
</header>

<style>
  /* 1. Unscrolled (Transparent floating state over full-bleed hero) */
  #main-navbar {
    background-color: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, padding 0.3s ease;
  }

  #main-navbar .nav-link {
    color: rgba(255, 252, 245, 0.85);
  }
  #main-navbar .nav-link:hover {
    color: #FFFFFF;
  }

  #main-navbar .nav-phone {
    color: rgba(255, 252, 245, 0.75);
  }
  #main-navbar .nav-phone:hover {
    color: #FFFFFF;
  }

  #main-navbar .nav-cta {
    background-color: rgba(255, 252, 245, 0.15);
    border: 1px solid rgba(255, 252, 245, 0.35);
    color: #FAF8F5;
  }
  #main-navbar .nav-cta:hover {
    background-color: rgba(255, 252, 245, 0.25);
  }

  #main-navbar .nav-mobile-btn {
    background-color: rgba(255, 252, 245, 0.12);
    border: 1px solid rgba(255, 252, 245, 0.25);
    color: #FAF8F5;
  }
  #main-navbar .nav-bar-line {
    background-color: #FAF8F5;
  }

  /* 2. Scrolled State (Gliding past hero into content sections) */
  #main-navbar.scrolled {
    background-color: rgba(250, 248, 245, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(104, 125, 99, 0.18);
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
    box-shadow: 0 4px 25px -4px rgba(32, 23, 19, 0.08);
  }

  #main-navbar.scrolled .nav-logo-white {
    opacity: 0;
    pointer-events: none;
  }

  #main-navbar.scrolled .nav-logo-dark {
    opacity: 1;
    pointer-events: auto;
  }

  #main-navbar.scrolled .nav-link {
    color: rgba(32, 23, 19, 0.82);
  }
  #main-navbar.scrolled .nav-link:hover {
    color: #201713;
  }

  #main-navbar.scrolled .nav-phone {
    color: rgba(32, 23, 19, 0.65);
  }
  #main-navbar.scrolled .nav-phone:hover {
    color: #201713;
  }

  #main-navbar.scrolled .nav-cta {
    background-color: #201713;
    border-color: #201713;
    color: #FAF8F5;
  }
  #main-navbar.scrolled .nav-cta:hover {
    background-color: #352A23;
  }

  #main-navbar.scrolled .nav-mobile-btn {
    background-color: rgba(250, 248, 245, 0.9);
    border-color: rgba(104, 125, 99, 0.3);
  }
  #main-navbar.scrolled .nav-bar-line {
    background-color: #201713;
  }

  #main-navbar.nav-hide {
    transform: translateY(-100%);
  }
</style>
