---
// Editorial Infinite Marquee Ribbon (Quiet Luxury Ticker)
const items = [
  { text: 'Clubhouse Café Jalandhar', highlight: 'Flagship' },
  { text: 'Clubhouse Café Amritsar', highlight: 'Coming Soon' },
  { text: 'Koko by Clubhouse', highlight: 'Patisserie' },
  { text: 'Arth by Clubhouse', highlight: 'Dining' },
  { text: 'Clubhouse Café Jalandhar', highlight: 'Model Town' },
  { text: 'Clubhouse Café Amritsar', highlight: 'Sanctuary' },
  { text: 'Koko by Clubhouse', highlight: 'Artisanal' },
  { text: 'Arth by Clubhouse', highlight: 'Experience' },
];
---

<div class="relative py-4 md:py-5 bg-ivory-muted/60 border-y border-sage/20 overflow-hidden select-none" aria-hidden="true">
  <div class="marquee-track flex whitespace-nowrap will-change-transform">
    {/* First copy */}
    <div class="flex items-center gap-8 md:gap-12 animate-marquee shrink-0">
      {items.map((item) => (
        <div class="flex items-center gap-8 md:gap-12">
          <span class="font-serif italic text-base sm:text-lg md:text-xl text-espresso/90 tracking-wide font-medium sm:font-normal">
            {item.text}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-gold/70"></span>
          <span class="text-[10px] uppercase tracking-[0.28em] font-semibold text-espresso-soft">
            {item.highlight}
          </span>
          <span class="w-1 h-1 rounded-full bg-gold/50"></span>
        </div>
      ))}
    </div>

    {/* Duplicate copy for seamless loop */}
    <div class="flex items-center gap-8 md:gap-12 animate-marquee shrink-0" aria-hidden="true">
      {items.map((item) => (
        <div class="flex items-center gap-8 md:gap-12">
          <span class="font-serif italic text-base sm:text-lg md:text-xl text-espresso/90 tracking-wide font-medium sm:font-normal">
            {item.text}
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-gold/70"></span>
          <span class="text-[10px] uppercase tracking-[0.28em] font-semibold text-espresso-soft">
            {item.highlight}
          </span>
          <span class="w-1 h-1 rounded-full bg-gold/50"></span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .animate-marquee {
    animation: marquee 38s linear infinite;
  }

  .marquee-track:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>
