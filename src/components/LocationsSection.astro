---
import { locationsData } from '@/data/locations';
import { businessData } from '@/data/business';

const jalandhar = locationsData.find((l) => l.id === 'jalandhar') || locationsData[0];
const amritsar = locationsData.find((l) => l.id === 'amritsar') || locationsData[1];
---

<section
  id="locations"
  class="scroll-mt-24 relative py-20 md:py-28 px-6 md:px-12 lg:px-16 bg-ivory overflow-hidden content-auto"
  aria-label="Clubhouse Locations"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="max-w-2xl mb-12 md:mb-16">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-8 h-[1px] bg-gold"></span>
        <span class="text-[11px] uppercase tracking-[0.3em] font-semibold text-gold-dark">
          Destinations
        </span>
      </div>
      <h2 class="font-serif text-4xl sm:text-5xl md:text-6xl text-espresso font-bold sm:font-semibold tracking-tight">
        Find Your <br />
        <span class="font-serif italic text-gold-dark font-bold sm:font-semibold">Clubhouse.</span>
      </h2>
      <p class="text-xs sm:text-sm text-espresso-muted mt-3 leading-relaxed font-normal">
        From our flagship home in Model Town, Jalandhar, to our upcoming sanctuary in Amritsar.
      </p>
    </div>

    <!-- 2 Locations Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8 items-stretch">
      <!-- JALANDHAR CARD (Col 7) -->
      <article class="lg:col-span-7 rounded-2xl bg-ivory-muted/60 border border-espresso/8 p-8 md:p-10 shadow-sm flex flex-col justify-between relative overflow-hidden">

        <div class="relative z-10">
          <div class="flex items-center justify-between gap-4 mb-5">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sage-pale/80 text-espresso text-[10px] uppercase tracking-[0.2em] font-semibold border border-sage/30">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-dark"></span>
              {jalandhar.badge}
            </span>
            <span class="text-xs uppercase tracking-widest text-espresso-soft font-medium">Punjab, India</span>
          </div>

          <h3 class="font-serif text-3xl md:text-4xl text-espresso font-bold sm:font-semibold mb-3">
            {jalandhar.city}
          </h3>

          <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed mb-6 max-w-lg font-normal">
            {jalandhar.description}
          </p>

          <!-- Address & Details Block -->
          <div class="space-y-4 pt-5 border-t border-sage/20 text-xs text-espresso">
            <div>
              <span class="block text-[10px] uppercase tracking-[0.2em] text-gold-dark font-semibold mb-1">
                Address
              </span>
              <p class="text-xs sm:text-sm text-espresso leading-relaxed font-normal">
                {jalandhar.fullAddress}
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
              <div>
                <span class="block text-[10px] uppercase tracking-[0.2em] text-gold-dark font-semibold mb-1">
                  Operating Hours
                </span>
                <p class="text-xs sm:text-sm font-medium text-espresso">
                  {jalandhar.hours}
                </p>
              </div>
              <div>
                <span class="block text-[10px] uppercase tracking-[0.2em] text-gold-dark font-semibold mb-1">
                  Direct Line
                </span>
                <a
                  href={jalandhar.phoneHref}
                  class="text-xs sm:text-sm font-medium text-espresso hover:text-gold-dark transition-colors inline-flex items-center gap-1.5"
                >
                  <span>{businessData.phoneFormatted}</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons (Full width on mobile for thumb tap target) -->
        <div class="relative z-10 mt-8 pt-6 border-t border-sage/20 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={jalandhar.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-espresso hover:bg-espresso-light text-ivory text-xs uppercase tracking-[0.16em] font-medium transition-all shadow-sm hover:scale-[1.02] active:scale-[0.98] min-h-[44px]"
          >
            <span>Get Directions</span>
            <svg class="w-3.5 h-3.5 text-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <button
            type="button"
            id="copy-address-btn"
            data-address={jalandhar.fullAddress}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-transparent hover:bg-sage-pale border border-sage/35 text-espresso text-xs uppercase tracking-[0.16em] font-medium transition-all hover:border-espresso hover:scale-[1.02] active:scale-[0.98] min-h-[44px]"
            aria-label="Copy Clubhouse Café address to clipboard"
          >
            <svg class="w-3.5 h-3.5 text-gold-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-address-text">Copy Address</span>
          </button>

          <a
            href={jalandhar.phoneHref}
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-full bg-transparent hover:bg-sage-pale border border-sage/35 text-espresso text-xs uppercase tracking-[0.16em] font-medium transition-all hover:border-espresso hover:scale-[1.02] active:scale-[0.98] min-h-[44px]"
          >
            Call Clubhouse
          </a>
        </div>
      </article>

      <!-- AMRITSAR CARD (Col 5) - Polished Luxury Placeholder Without Fake Data -->
      <article class="lg:col-span-5 rounded-2xl bg-ivory-muted/60 border border-espresso/8 p-8 md:p-10 shadow-sm flex flex-col justify-between relative overflow-hidden">
        <div>
          <div class="flex items-center justify-between gap-4 mb-5">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold/15 text-gold-dark text-[10px] uppercase tracking-[0.2em] font-semibold border border-gold/25">
              <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
              {amritsar.badge}
            </span>
            <span class="text-xs uppercase tracking-widest text-espresso-soft font-medium">Punjab, India</span>
          </div>

          <h3 class="font-serif text-3xl md:text-4xl text-espresso font-bold sm:font-semibold mb-3">
            {amritsar.city}
          </h3>

          <p class="text-xs sm:text-sm text-espresso-muted leading-relaxed mb-6 font-normal">
            {amritsar.description}
          </p>

          <!-- Coming Soon Status Box -->
          <div class="p-5 rounded-2xl bg-ivory/85 border border-sage/20 space-y-2">
            <span class="block text-[10px] uppercase tracking-[0.25em] text-gold-dark font-semibold">
              Location Status
            </span>
            <p class="font-serif text-xl sm:text-2xl text-espresso font-bold sm:font-semibold">
              Address Coming Soon
            </p>
            <p class="text-xs text-espresso-soft leading-relaxed">
              Our culinary and architectural teams are designing a distinctive sanctuary in Amritsar. Exact location coordinates and opening invitations will be released on Instagram.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-sage/20 flex items-center justify-between">
          <span class="text-xs text-espresso-soft font-medium">Follow announcements</span>
          <a
            href={businessData.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs uppercase tracking-wider font-semibold text-espresso hover:text-gold-dark underline underline-offset-4"
          >
            {businessData.instagramHandle} →
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  function setupCopyAddress() {
    const btn = document.getElementById('copy-address-btn');
    const label = document.getElementById('copy-address-text');
    if (!btn || !label) return;

    btn.addEventListener('click', async () => {
      const address = btn.getAttribute('data-address') || '';
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(address);
        } else {
          const textarea = document.createElement('textarea');
          textarea.value = address;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);
        }
        label.textContent = '✓ Copied Address!';
        btn.classList.add('bg-sage-pale', 'border-emerald-700/50');
        setTimeout(() => {
          label.textContent = 'Copy Address';
          btn.classList.remove('bg-sage-pale', 'border-emerald-700/50');
        }, 2200);
      } catch (err) {
        label.textContent = '✓ Copied!';
        setTimeout(() => {
          label.textContent = 'Copy Address';
        }, 2000);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCopyAddress);
  } else {
    setupCopyAddress();
  }
</script>
