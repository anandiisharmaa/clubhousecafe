---
import ClubhouseLogo from './ClubhouseLogo.astro';
import { businessData } from '@/data/business';
---

<section
  class="relative py-20 md:py-28 lg:py-32 px-6 md:px-12 lg:px-16 bg-sage-deep text-ivory overflow-hidden"
  aria-label="Reserve a Table"
>


  <div class="relative z-10 max-w-4xl mx-auto text-center">
    <!-- Official Brand Logo (White) -->
    <div class="flex justify-center mb-6">
      <ClubhouseLogo variant="white" size="lg" />
    </div>

    <!-- Section Eyebrow -->
    <span class="block text-[11px] uppercase tracking-[0.35em] text-gold-light font-semibold mb-4">
      The Clubhouse Invitation
    </span>

    <!-- Major Emotional Headline -->
    <h2 class="font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl text-ivory font-bold sm:font-semibold tracking-tight leading-[1.03] mb-6 sm:mb-8">
      Save a Seat. <br />
      <span class="font-serif italic text-gold-light font-bold sm:font-semibold">
        Stay a While.
      </span>
    </h2>

    <!-- Supporting Text -->
    <p class="font-sans text-base sm:text-lg md:text-xl text-ivory/80 max-w-xl mx-auto leading-relaxed mb-10 sm:mb-12 font-normal">
      Whether you are stopping by for a quiet morning roast, an unhurried brunch, or late-night dessert in good company.
    </p>

    <!-- CTAs (Full width on mobile for thumb ergonomics) -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 sm:gap-5 w-full max-w-md mx-auto">
      <button
        type="button"
        data-open-reservation
        class="w-full sm:w-auto inline-flex items-center justify-center min-h-[48px] px-9 py-4 rounded-full bg-ivory hover:bg-gold-light text-espresso text-xs uppercase tracking-[0.2em] font-semibold transition-all duration-300 shadow-xl hover:scale-105 active:scale-95 text-center"
      >
        Book a Table
      </button>

      <a
        href={businessData.phoneHref}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 min-h-[48px] px-8 py-4 rounded-full bg-white/10 hover:bg-white/15 border border-white/25 text-ivory text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 hover:scale-105 active:scale-95 text-center"
      >
        <svg class="w-4 h-4 text-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call: {businessData.phone}</span>
      </a>
    </div>

    <!-- Quick Hours Footer -->
    <p class="text-xs text-ivory/60 mt-10 tracking-widest uppercase font-medium">
      Open Daily · 9:30 AM – 12:00 AM · Model Town, Jalandhar
    </p>
  </div>
</section>
