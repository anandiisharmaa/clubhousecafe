---
import ClubhouseLogo from './ClubhouseLogo.astro';
import { businessData } from '@/data/business';

const mobileNavLinks = [
  { label: 'About', href: '/#about', number: '01' },
  { label: 'Loyalty Program', href: '/#loyalty', number: '02' },
  { label: 'Menu', href: '/#menu', number: '03' },
  { label: 'Experience', href: '/#experience', number: '04' },
  { label: 'Gallery', href: '/#gallery', number: '05' },
  { label: 'Locations', href: '/#locations', number: '06' },
];
---

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 bg-ivory text-espresso transition-all duration-500 ease-in-out -translate-y-full opacity-0 pointer-events-none flex flex-col justify-between min-h-[100dvh] max-h-[100dvh] overflow-y-auto overscroll-contain pt-[max(1.75rem,env(safe-area-inset-top))] pb-[max(1.75rem,env(safe-area-inset-bottom))] px-6 sm:px-10"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
>
  <!-- Top bar inside menu -->
  <div class="flex items-center justify-between border-b border-sage/15 pb-4">
    <ClubhouseLogo size="sm" />
    <button
      id="mobile-menu-close-btn"
      type="button"
      class="w-11 h-11 rounded-full flex items-center justify-center border border-sage/25 text-espresso bg-sage-pale hover:bg-sage-light transition-colors active:scale-95"
      aria-label="Close navigation menu"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Live Status & Google Rating Strip -->
  <div class="pt-4 flex flex-wrap items-center justify-between gap-2.5">
    <div class="flex items-center gap-2 text-[11px] text-espresso">
      <span data-live-status-dot class="w-2 h-2 rounded-full bg-emerald-700 animate-pulse"></span>
      <span data-live-status-text class="font-medium">Open Today · 9:30 AM – 12:00 AM</span>
    </div>

    <a
      href={businessData.googleMapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sage-pale/80 border border-sage/30 text-espresso text-[11px] hover:border-gold transition-colors"
      aria-label="View Google Reviews"
    >
      <span class="text-gold font-bold">★</span>
      <span class="font-semibold text-espresso">{businessData.rating}</span>
      <span class="text-espresso-soft text-[10px]">({businessData.ratingCount} Reviews)</span>
      <span class="text-gold-dark text-xs">↗</span>
    </a>
  </div>

  <!-- Primary Editorial Nav Links -->
  <nav class="my-auto py-6 flex flex-col gap-3.5">
    {mobileNavLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link group flex items-baseline justify-between border-b border-sage/15 pb-2.5 transition-colors"
      >
        <span class="font-serif text-3xl sm:text-4xl text-espresso group-hover:text-gold-dark font-bold sm:font-semibold transition-colors">
          {link.label}
        </span>
        <span class="font-sans text-xs tracking-widest text-espresso-soft/70">
          {link.number}
        </span>
      </a>
    ))}

    <!-- High-Impact Dual Mobile Action Buttons -->
    <div class="pt-4 grid grid-cols-2 gap-2.5">
      <button
        type="button"
        data-open-reservation
        class="py-3.5 px-4 rounded-full bg-gradient-to-r from-[#D8B467] via-[#E4D3B0] to-[#C99E4A] text-espresso text-[11px] uppercase tracking-[0.16em] font-bold transition-all shadow-md active:scale-95 text-center flex items-center justify-center gap-1"
      >
        <span>Book Table</span>
        <span>→</span>
      </button>

      <a
        href={businessData.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="py-3.5 px-4 rounded-full bg-espresso text-ivory text-[11px] uppercase tracking-[0.16em] font-medium transition-all shadow-sm active:scale-95 text-center flex items-center justify-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5 text-gold-light" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Directions</span>
      </a>
    </div>
  </nav>

  <!-- Mobile Footer / Direct Contact Info -->
  <div class="border-t border-sage/20 pt-5 space-y-3 text-xs text-espresso-muted">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <span class="block text-[11px] uppercase tracking-wider text-espresso font-semibold">Flagship Café</span>
        <span class="text-espresso-soft">Model Town, Jalandhar</span>
      </div>
      <div class="text-right">
        <span class="block text-[11px] uppercase tracking-wider text-espresso font-semibold">Hours</span>
        <span class="text-espresso-soft">{businessData.hours}</span>
      </div>
    </div>

    <div class="flex items-center justify-between pt-1">
      <a
        href={businessData.phoneHref}
        class="inline-flex items-center gap-1.5 font-medium text-espresso hover:text-gold-dark"
      >
        <span>Call: {businessData.phoneFormatted}</span>
      </a>
      <a
        href={businessData.whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-medium text-emerald-800 hover:text-emerald-900"
      >
        <span>WhatsApp Concierge ↗</span>
      </a>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('.mobile-nav-link, #mobile-menu [data-open-reservation]');

    if (!openBtn || !closeBtn || !menu) return;

    function openMenu() {
      menu?.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
      menu?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      openBtn?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      menu?.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
      menu?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      openBtn?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    }

    openBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    links.forEach((l) => {
      l.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('-translate-y-full')) {
        closeMenu();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>
